# Required: fill these in locally, never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Local AI: Ollama cloud functionality must also be disabled in the runtime.
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen3.5:4b
TIMEZONE=America/Toronto

# Positive limits; POLL_LIMIT <= 100, MAX_MESSAGE_LENGTH <= 4096.
RATE_LIMIT=10
MAX_MESSAGE_LENGTH=2000
MAX_TOOL_CALLS=2
POLL_LIMIT=10
MAX_MESSAGE_AGE=300

# Seconds. EXTERNAL_TIMEOUT must exceed the 25-second Telegram long poll.
CONNECT_TIMEOUT=10
INFERENCE_TIMEOUT=180
EXTERNAL_TIMEOUT=45
REQUEST_BUDGET=400
